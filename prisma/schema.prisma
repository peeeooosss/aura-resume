generator client {
  provider = "prisma-client-js"
  previewFeatures = ["clientExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  username      String?            @unique
  name          String?
  passwordHash  String?
  image         String?
  plan          String             @default("free")
  onboarded     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  resumes            Resume[]
  analyses           Analysis[]
  linkedin           LinkedInProfile?
  jobMatches         JobMatch[]
  roadmaps           Roadmap[]
  portfolios         Portfolio[]
  payments           Payment[]
  usage              UsageRecord[]
  linkedinTemplates  LinkedInTemplate[]
  creditBalance      CreditBalance?
  interviewSessions  InterviewSession[]
}

model Resume {
  id        String     @id @default(cuid())
  userId    String
  title     String
  fileUrl   String
  fileKey   String?
rawText        String?   @db.Text
  optimizedText  String?   @db.Text
  status         String    @default("uploaded")
  version   Int        @default(1)
  isPrimary Boolean    @default(false)
  parentId  String?
  parent    Resume?    @relation("ResumeVersions", fields: [parentId], references: [id], onDelete: SetNull)
  children  Resume[]   @relation("ResumeVersions")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses Analysis[]
  jobs     JobMatch[]
  roadmaps Roadmap[]
  interviewSessions InterviewSession[]
  portfolios Portfolio[]

  @@index([userId, status])
  @@index([userId, parentId])
}

model Analysis {
  id                String   @id @default(cuid())
  resumeId          String
  userId            String
  type              String   // "resume" | "linkedin" | "roadmap" | "gap"
  overallScore      Float?
  strengths         Json?
  redFlags          Json?
  suggestions       Json?
  keywordGaps       Json?
  jobRolePotential  Json?
  modelUsed         String?
  tokensUsed        Int?
  createdAt         DateTime @default(now())

  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinkedInProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  linkedinUrl   String?
  headline      String?
  summary       String?  @db.Text
  experience    Json?
  skills        Json?
  analysisScore Float?
  suggestions   Json?
  lastSyncedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobMatch {
  id            String   @id @default(cuid())
  userId        String
  resumeId      String?
  title         String
  company       String?
  location      String?
  salary        String?
  url           String?
  matchScore    Float?
  source        String?
  skills        Json?
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)
}

model Roadmap {
  id            String   @id @default(cuid())
  userId        String
  resumeId      String
  title         String
  goalRole      String
  currentRole   String?
  overview      String?  @db.Text

  currentStrengths  Json?
  criticalGaps      Json?

  phases           Json

  currentPhase     Int      @default(1)
  currentWeek      Int      @default(1)
  currentDay       Int      @default(1)
  totalTasks       Int      @default(0)
  completedTasks   Int      @default(0)
  progress         Float    @default(0)

  startDate        DateTime @default(now())
  endDate          DateTime
  isActive         Boolean  @default(true)
  isCompleted      Boolean  @default(false)

  phase1Unlocked   Boolean  @default(true)
  phase2Unlocked   Boolean  @default(false)
  phase3Unlocked   Boolean  @default(false)
  phase4Unlocked   Boolean  @default(false)

  aiGenerated      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([userId, resumeId])
  @@index([userId])
}

model Portfolio {
  id              String    @id @default(cuid())
  userId          String
  resumeId        String?
  title           String
  slug            String    @unique
  description     String?   @db.Text
  template        String?   @default("modern")
  theme           Json?
  data            Json?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  views           Int       @default(0)
  uniqueVisitors  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([slug])
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  razorpayId    String?  @unique
  amount        Int
  currency      String   @default("INR")
  plan          String
  status        String   @default("created")
  metadata      Json?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "resume_analysis" | "linkedin_analysis" | "fix" | "roadmap" | "job_search" | "linkedin_template"
  count     Int      @default(1)
  modelUsed String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LinkedInTemplate {
  id          String   @id @default(cuid())
  userId      String
  jdText      String   @db.Text
  jdUrl       String?
  templates   Json
  matchHighlights Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id             String   @id @default(cuid())
  userId         String
  resumeId       String
  targetRole     String
  interviewType  String   @default("mixed") // "technical" | "behavioral" | "mixed"
  difficulty     String   @default("medium") // "easy" | "medium" | "hard"
  status         String   @default("active") // "active" | "completed" | "abandoned"

  questions      Json     // Array of { question, answer, score, feedback, followUp }
  currentQ       Int      @default(0)
  totalQuestions  Int     @default(10)

  overallScore   Float?
  scores         Json?    // { technical, communication, confidence, completeness }
  feedback       Json?    // Detailed feedback per question
  summary        String?  @db.Text

  startedAt      DateTime @default(now())
  completedAt    DateTime?
  duration       Int?     // seconds

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}